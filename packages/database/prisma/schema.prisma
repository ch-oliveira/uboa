// schema.prisma

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

enum Role {
  ADMIN
  GESTOR
  TECNICO
  SOLICITANTE
}

enum TipoPredio {
  ESCOLA
  HOSPITAL
  PRACA
  ADMINISTRATIVO
  UBS
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusOS {
  RECEBIDO
  EM_TRIAGEM
  AGENDADO
  AGUARDANDO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

enum TipoManifestacao {
  RECLAMACAO
  ELOGIO
  SUGESTAO
  OUTRO
}

enum StatusManifestacao {
  RECEBIDA
  EM_ANALISE
  RESPONDIDA
  ENCAMINHADA
  ARQUIVADA
  CONVERTIDA_EM_OS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Usuario {
  id            String   @id @default(uuid())
  nome          String
  email         String   @unique
  senha_hash    String
  role          Role     @default(SOLICITANTE)
  especialidade String?  @default("GERAL") // ELETRICA, HIDRAULICA, ALVENARIA, CLIMATIZACAO, PINTURA, GERAL
  telefone      String?
  ativo         Boolean  @default(true)
  token_version Int      @default(1)
  criado_em     DateTime @default(now())
  atualizado    DateTime @updatedAt

  predios_geridos           Predio[]        @relation("GestorPredio")
  chamados_solicitados      OrdemServico[]  @relation("SolicitanteOS")
  chamados_atribuidos       OrdemServico[]  @relation("TecnicoOS")
  manifestacoes_respondidas Manifestacao[]  @relation("ManifestacaoRespondente")
  auditorias                AuditoriaLog[]

  @@map("usuarios")
}

model Predio {
  id                  String     @id @default(uuid())
  nome                String
  tipo                TipoPredio
  setor               String?    @default("ADMINISTRACAO") // Educação, Saúde, Obras, etc.
  porte               String?    @default("MEDIO") // PEQUENO, MEDIO, GRANDE
  capacidade          Int?
  endereco            String
  latitude            Float?
  longitude           Float?
  ativo               Boolean    @default(true)
  motivo_desativacao  String?
  gestor_id           String?
  gestor              Usuario?   @relation("GestorPredio", fields: [gestor_id], references: [id])
  criado_em           DateTime   @default(now())
  atualizado          DateTime   @updatedAt

  // PostGIS: O tipo Unsupported permite que o Prisma conviva com tipos do DB.
  coordenadas Unsupported("geometry(Point, 4326)")?

  ordens_servico OrdemServico[]
  vistorias      AgendaVistoria[]
  manifestacoes  Manifestacao[]

  @@map("predios")
}

model OrdemServico {
  id                   String     @id @default(uuid())
  codigo               String     @unique @default(dbgenerated("concat('OS-', floor(random() * 900000 + 100000)::text)"))
  titulo               String
  descricao            String
  categoria            String?    @default("GERAL") // ELETRICA, HIDRAULICA, ALVENARIA, CLIMATIZACAO, PINTURA, GERAL
  prioridade           Prioridade @default(MEDIA)
  status               StatusOS   @default(RECEBIDO)
  
  predio_id            String
  predio               Predio     @relation(fields: [predio_id], references: [id])
  
  solicitante_id       String
  solicitante          Usuario    @relation("SolicitanteOS", fields: [solicitante_id], references: [id])
  
  tecnico_atribuido_id String?
  tecnico              Usuario?   @relation("TecnicoOS", fields: [tecnico_atribuido_id], references: [id])
  
  fotos                String[]   // URLs array
  fotos_conclusao      String[]   @default([]) // Evidência fotográfica obrigatória para encerramento
  motivo_pausa         String?    // Obrigatório quando status for AGUARDANDO
  motivo_cancelamento  String?    // Obrigatório quando status for CANCELADO (Auditoria / Tribunal de Contas)
  data_limite_sla      DateTime?  // Prazo fatal calculado na criação/triagem
  iniciado_em          DateTime?  // Timestamp gravado na transição para EM_EXECUCAO
  concluido_em         DateTime?  // Timestamp gravado na transição para CONCLUIDO
  pausado_em           DateTime?  // Timestamp gravado ao pausar em AGUARDANDO
  tempo_pausa_minutos  Int        @default(0) // Tempo total acumulado em pausa (descontado do MTTR e estendendo SLA)
  historico_pausas     Json?      @default("[]") // Lista de períodos de pausa com justificativas para auditoria
  sla_violado          Boolean    @default(false) // Flag de infração de prazo para fiscalização do Tribunal de Contas
  motivo_violacao_sla  String?    // Descrição ou justificativa da extrapolação do prazo

  ordem_vinculada_id   String?
  ordem_vinculada      OrdemServico?  @relation("HistoricoOS", fields: [ordem_vinculada_id], references: [id])
  ordens_derivadas     OrdemServico[] @relation("HistoricoOS")

  agendamentos         AgendaVistoria[]
  manifestacoes_origem Manifestacao[] @relation("ManifestacaoOS")

  criado_em            DateTime   @default(now())
  atualizado           DateTime   @updatedAt

  @@map("ordens_servico")
}

model AuditoriaLog {
  id               String      @id @default(uuid())
  entidade_afetada String
  entidade_id      String
  acao             AuditAction
  
  usuario_id       String
  usuario          Usuario     @relation(fields: [usuario_id], references: [id])
  
  dados_antigos    Json?
  dados_novos      Json?
  
  criado_em        DateTime    @default(now())

  @@map("auditoria_logs")
}

model AgendaVistoria {
  id               String        @id @default(uuid())
  titulo           String
  subtitulo        String
  horario          String
  data_agendada    DateTime?     @default(now())
  tipo             String        @default("geral") // eletrica, hidraulica, acessibilidade, geral
  recorrencia      String?       @default("UNICA") // UNICA, MENSAL, TRIMESTRAL, SEMESTRAL, ANUAL
  concluido        Boolean       @default(false)
  tecnico          String?
  tecnico_id       String?
  predio_id        String?
  predio           Predio?       @relation(fields: [predio_id], references: [id])
  laudo_tecnico    String?
  fotos_vistoria   String[]      @default([])
  ordem_servico_id String?
  ordem_servico    OrdemServico? @relation(fields: [ordem_servico_id], references: [id])
  criado_em        DateTime      @default(now())
  atualizado       DateTime      @default(now()) @updatedAt

  @@map("agenda_vistorias")
}

model ConfiguracaoSistema {
  id               String   @id @default("default")
  prefeitura_nome  String   @default("Prefeitura Municipal de Gestão Urbana")
  secretaria_nome  String   @default("Secretaria de Infraestrutura e Zeladoria Predial")
  gestor_nome      String   @default("Mariana Alves")
  gestor_cargo     String   @default("Gestora Municipal de Zeladoria")
  gestor_email     String   @default("mariana.alves@gestaourbana.gov.br")
  gestor_telefone  String   @default("(11) 3241-8900")
  sla_urgente_h    Int      @default(4)
  sla_alta_h       Int      @default(24)
  sla_media_h      Int      @default(72)
  sla_baixa_h      Int      @default(168)
  mttr_alert_h     Int      @default(8)
  preventiva_goal  Int      @default(90)
  sound_alerts     Boolean  @default(true)
  push_notif       Boolean  @default(true)
  whatsapp_alerts  Boolean  @default(false)
  auto_dispatch    Boolean  @default(false)
  criado_em        DateTime @default(now())
  atualizado       DateTime @updatedAt

  @@map("configuracoes_sistema")
}

model Manifestacao {
  id                    String             @id @default(uuid())
  protocolo             String             @unique @default(dbgenerated("concat('OUV-', floor(random() * 900000 + 100000)::text)"))
  tipo                  TipoManifestacao   @default(RECLAMACAO)
  categoria             String             @default("GERAL") // Atendimento, Alimentação / Merenda, Limpeza, Ruído, Gestão, Geral
  descricao             String
  
  predio_id             String?
  predio                Predio?            @relation(fields: [predio_id], references: [id])
  
  local_referencia      String?            // Ex: "Rua das Flores, próx. ao nº 120", "Praça Central"
  bairro                String?            // Ex: "Centro", "Jardim América"
  
  anonimo               Boolean            @default(false)
  manifestante_nome     String?
  manifestante_email    String?
  manifestante_telefone String?
  
  status                StatusManifestacao @default(RECEBIDA)
  
  resposta_oficial      String?
  respondido_em         DateTime?
  respondido_por_id     String?
  respondido_por        Usuario?           @relation("ManifestacaoRespondente", fields: [respondido_por_id], references: [id])
  
  motivo_arquivamento   String?
  
  ordem_servico_id      String?
  ordem_servico         OrdemServico?      @relation("ManifestacaoOS", fields: [ordem_servico_id], references: [id])
  
  criado_em             DateTime           @default(now())
  atualizado            DateTime           @updatedAt

  @@index([predio_id, status])
  @@index([status, criado_em])
  @@map("manifestacoes")
}

