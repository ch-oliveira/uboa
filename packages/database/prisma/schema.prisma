// schema.prisma

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

enum Role {
  ADMIN
  GESTOR
  TECNICO
  SOLICITANTE
}

enum TipoPredio {
  ESCOLA
  HOSPITAL
  PRACA
  ADMINISTRATIVO
  UBS
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusOS {
  RECEBIDO
  EM_TRIAGEM
  AGENDADO
  AGUARDANDO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

enum TipoManifestacao {
  RECLAMACAO
  ELOGIO
  SUGESTAO
  OUTRO
}

enum StatusManifestacao {
  RECEBIDA
  EM_ANALISE
  RESPONDIDA
  ENCAMINHADA
  ARQUIVADA
  CONVERTIDA_EM_OS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum ModuloSistema {
  ZELADORIA_PREDIAL
  OUVIDORIA_CIDADA
  AGENDA_PREVENTIVA
  GESTAO_MATERIAIS
  COPILOT_IA
  PORTAL_TRANSPARENCIA
}

model Prefeitura {
  id             String          @id @default(uuid())
  slug           String          @unique // ex: "default", "osasco", "americana"
  nome           String          // "Prefeitura Municipal de Gestão Urbana"
  cnpj           String?         @unique
  brasao_url     String?
  modulos_ativos ModuloSistema[] @default([ZELADORIA_PREDIAL, OUVIDORIA_CIDADA, AGENDA_PREVENTIVA, COPILOT_IA])
  ativo          Boolean         @default(true)
  metadata       Json?           @default("{}")

  configuracao   ConfiguracaoSistema?
  usuarios       Usuario[]
  predios        Predio[]
  ordens_servico OrdemServico[]
  manifestacoes  Manifestacao[]
  vistorias      AgendaVistoria[]
  auditorias     AuditoriaLog[]
  materiais      Material[]
  contratos      ContratoManutencao[]
  ativos         AtivoPredial[]
  boletins_medicao BoletimMedicao[]

  criado_em      DateTime        @default(now())
  atualizado     DateTime        @updatedAt

  @@map("prefeituras")
}

model Usuario {
  id            String   @id @default(uuid())
  nome          String
  email         String   @unique
  senha_hash    String
  role          Role     @default(SOLICITANTE)
  especialidade String?  @default("GERAL") // ELETRICA, HIDRAULICA, ALVENARIA, CLIMATIZACAO, PINTURA, GERAL
  telefone      String?
  ativo         Boolean  @default(true)
  token_version Int      @default(1)
  criado_em     DateTime @default(now())
  atualizado    DateTime @updatedAt

  prefeitura_id String?
  prefeitura    Prefeitura? @relation(fields: [prefeitura_id], references: [id])

  predios_geridos           Predio[]        @relation("GestorPredio")
  chamados_solicitados      OrdemServico[]  @relation("SolicitanteOS")
  chamados_atribuidos       OrdemServico[]  @relation("TecnicoOS")
  chamados_atestados        OrdemServico[]  @relation("AtestoOS")
  boletins_fiscalizados     BoletimMedicao[] @relation("FiscalBoletim")
  manifestacoes_respondidas Manifestacao[]  @relation("ManifestacaoRespondente")
  auditorias                AuditoriaLog[]

  @@index([prefeitura_id, role])
  @@index([prefeitura_id, email])
  @@map("usuarios")
}

model Predio {
  id                  String     @id @default(uuid())
  nome                String
  tipo                TipoPredio
  setor               String?    @default("ADMINISTRACAO") // Educação, Saúde, Obras, etc.
  porte               String?    @default("MEDIO") // PEQUENO, MEDIO, GRANDE
  capacidade          Int?
  endereco            String
  latitude            Float?
  longitude           Float?
  ativo               Boolean    @default(true)
  motivo_desativacao  String?
  gestor_id           String?
  gestor              Usuario?   @relation("GestorPredio", fields: [gestor_id], references: [id])
  criado_em           DateTime   @default(now())
  atualizado          DateTime   @updatedAt

  prefeitura_id       String?
  prefeitura          Prefeitura? @relation(fields: [prefeitura_id], references: [id])

  // PostGIS: O tipo Unsupported permite que o Prisma conviva com tipos do DB.
  coordenadas Unsupported("geometry(Point, 4326)")?

  ordens_servico OrdemServico[]
  vistorias      AgendaVistoria[]
  manifestacoes  Manifestacao[]
  ativos         AtivoPredial[]

  @@index([prefeitura_id, ativo])
  @@index([prefeitura_id, tipo])
  @@map("predios")
}

model OrdemServico {
  id                   String     @id @default(uuid())
  codigo               String     @unique @default(dbgenerated("concat('OS-', floor(random() * 900000 + 100000)::text)"))
  titulo               String
  descricao            String
  categoria            String?    @default("GERAL") // ELETRICA, HIDRAULICA, ALVENARIA, CLIMATIZACAO, PINTURA, GERAL
  prioridade           Prioridade @default(MEDIA)
  status               StatusOS   @default(RECEBIDO)
  
  predio_id            String
  predio               Predio     @relation(fields: [predio_id], references: [id])

  ativo_id             String?
  ativo_predial        AtivoPredial? @relation(fields: [ativo_id], references: [id], onDelete: SetNull)
  
  solicitante_id       String
  solicitante          Usuario    @relation("SolicitanteOS", fields: [solicitante_id], references: [id])
  
  tecnico_atribuido_id String?
  tecnico              Usuario?   @relation("TecnicoOS", fields: [tecnico_atribuido_id], references: [id])
  
  fotos                String[]   // URLs array
  fotos_conclusao      String[]   @default([]) // Evidência fotográfica obrigatória para encerramento
  motivo_pausa         String?    // Obrigatório quando status for AGUARDANDO
  motivo_cancelamento  String?    // Obrigatório quando status for CANCELADO (Auditoria / Tribunal de Contas)
  data_limite_sla      DateTime?  // Prazo fatal calculado na criação/triagem
  iniciado_em          DateTime?  // Timestamp gravado na transição para EM_EXECUCAO
  concluido_em         DateTime?  // Timestamp gravado na transição para CONCLUIDO
  pausado_em           DateTime?  // Timestamp gravado ao pausar em AGUARDANDO
  tempo_pausa_minutos  Int        @default(0) // Tempo total acumulado em pausa (descontado do MTTR e estendendo SLA)
  historico_pausas     Json?      @default("[]") // Lista de períodos de pausa com justificativas para auditoria
  sla_violado          Boolean    @default(false) // Flag de infração de prazo para fiscalização do Tribunal de Contas
  motivo_violacao_sla  String?    // Descrição ou justificativa da extrapolação do prazo

  // Gestão Financeira e Medição (Contratos Terceirizados / Tribunal de Contas)
  custo_materiais      Decimal?   @default(0.00) @db.Decimal(10, 2)
  custo_mao_de_obra    Decimal?   @default(0.00) @db.Decimal(10, 2)
  custo_total          Decimal?   @default(0.00) @db.Decimal(10, 2)
  empresa_terceirizada String?    // Nome da prestadora ou empreiteira terceirizada
  numero_empenho       String?    // Nota de empenho público municipal para fiscalização TCE
  contrato_id          String?    // Vínculo com contrato formal e nota de empenho
  contrato             ContratoManutencao? @relation(fields: [contrato_id], references: [id])
  materiais_consumidos ItemConsumoOS[]

  // Atesto Digital do Solicitante / Gestor da Unidade (Lei 14.133/2021)
  status_atesto           String?        @default("NAO_APLICAVEL") // NAO_APLICAVEL, PENDENTE, APROVADO, REJEITADO
  atestado_em             DateTime?
  atestado_por_id         String?
  atestado_por            Usuario?       @relation("AtestoOS", fields: [atestado_por_id], references: [id], onDelete: SetNull)
  parecer_atesto          String?
  assinatura_digital_hash String?        // Hash SHA-256 de integridade e auditoria
  avaliacao_atesto        Int?           // Avaliação de 1 a 5 estrelas

  boletim_medicao_id      String?
  boletim_medicao         BoletimMedicao? @relation(fields: [boletim_medicao_id], references: [id], onDelete: SetNull)

  prefeitura_id        String?
  prefeitura           Prefeitura? @relation(fields: [prefeitura_id], references: [id])

  ordem_vinculada_id   String?
  ordem_vinculada      OrdemServico?  @relation("HistoricoOS", fields: [ordem_vinculada_id], references: [id])
  ordens_derivadas     OrdemServico[] @relation("HistoricoOS")

  agendamentos         AgendaVistoria[]
  manifestacoes_origem Manifestacao[] @relation("ManifestacaoOS")

  criado_em            DateTime   @default(now())
  atualizado           DateTime   @updatedAt

  @@index([prefeitura_id, status])
  @@index([prefeitura_id, status_atesto])
  @@index([boletim_medicao_id])
  @@index([prefeitura_id, prioridade])
  @@index([prefeitura_id, predio_id, criado_em])
  @@map("ordens_servico")
}

model AuditoriaLog {
  id               String      @id @default(uuid())
  entidade_afetada String
  entidade_id      String
  acao             AuditAction
  
  usuario_id       String
  usuario          Usuario     @relation(fields: [usuario_id], references: [id])
  
  prefeitura_id    String?
  prefeitura       Prefeitura? @relation(fields: [prefeitura_id], references: [id])

  dados_antigos    Json?
  dados_novos      Json?
  
  criado_em        DateTime    @default(now())

  @@index([prefeitura_id, criado_em])
  @@map("auditoria_logs")
}

model AgendaVistoria {
  id               String        @id @default(uuid())
  titulo           String
  subtitulo        String
  horario          String
  data_agendada    DateTime?     @default(now())
  tipo             String        @default("geral") // eletrica, hidraulica, acessibilidade, geral
  recorrencia      String?       @default("UNICA") // UNICA, MENSAL, TRIMESTRAL, SEMESTRAL, ANUAL
  concluido        Boolean       @default(false)
  tecnico          String?
  tecnico_id       String?
  predio_id        String?
  predio           Predio?       @relation(fields: [predio_id], references: [id])
  laudo_tecnico    String?
  fotos_vistoria   String[]      @default([])
  ordem_servico_id String?
  ordem_servico    OrdemServico? @relation(fields: [ordem_servico_id], references: [id])

  prefeitura_id    String?
  prefeitura       Prefeitura?   @relation(fields: [prefeitura_id], references: [id])

  criado_em        DateTime      @default(now())
  atualizado       DateTime      @default(now()) @updatedAt

  @@index([prefeitura_id, concluido])
  @@map("agenda_vistorias")
}

model ConfiguracaoSistema {
  id               String      @id @default("default")
  prefeitura_nome  String      @default("Prefeitura Municipal de Gestão Urbana")
  secretaria_nome  String      @default("Secretaria de Infraestrutura e Zeladoria Predial")
  gestor_nome      String      @default("Mariana Alves")
  gestor_cargo     String      @default("Gestora Municipal de Zeladoria")
  gestor_email     String      @default("mariana.alves@gestaourbana.gov.br")
  gestor_telefone  String      @default("(11) 3241-8900")
  sla_urgente_h    Int         @default(4)
  sla_alta_h       Int         @default(24)
  sla_media_h      Int         @default(72)
  sla_baixa_h      Int         @default(168)
  mttr_alert_h     Int         @default(8)
  preventiva_goal  Int         @default(90)
  sound_alerts     Boolean     @default(true)
  push_notif       Boolean     @default(true)
  whatsapp_alerts  Boolean     @default(false)
  auto_dispatch    Boolean     @default(false)

  prefeitura_id    String?     @unique
  prefeitura       Prefeitura? @relation(fields: [prefeitura_id], references: [id], onDelete: Cascade)

  criado_em        DateTime    @default(now())
  atualizado       DateTime    @updatedAt

  @@map("configuracoes_sistema")
}

model Manifestacao {
  id                    String             @id @default(uuid())
  protocolo             String             @unique @default(dbgenerated("concat('OUV-', floor(random() * 900000 + 100000)::text)"))
  tipo                  TipoManifestacao   @default(RECLAMACAO)
  categoria             String             @default("GERAL") // Atendimento, Alimentação / Merenda, Limpeza, Ruído, Gestão, Geral
  descricao             String
  
  predio_id             String?
  predio                Predio?            @relation(fields: [predio_id], references: [id])
  
  local_referencia      String?            // Ex: "Rua das Flores, próx. ao nº 120", "Praça Central"
  bairro                String?            // Ex: "Centro", "Jardim América"
  
  anonimo               Boolean            @default(false)
  manifestante_nome     String?
  manifestante_email    String?
  manifestante_telefone String?
  
  status                StatusManifestacao @default(RECEBIDA)
  
  resposta_oficial      String?
  respondido_em         DateTime?
  respondido_por_id     String?
  respondido_por        Usuario?           @relation("ManifestacaoRespondente", fields: [respondido_por_id], references: [id])
  
  motivo_arquivamento   String?
  
  ordem_servico_id      String?
  ordem_servico         OrdemServico?      @relation("ManifestacaoOS", fields: [ordem_servico_id], references: [id])

  prefeitura_id         String?
  prefeitura            Prefeitura?        @relation(fields: [prefeitura_id], references: [id])
  
  criado_em             DateTime           @default(now())
  atualizado            DateTime           @updatedAt

  @@index([prefeitura_id, status])
  @@index([prefeitura_id, protocolo])
  @@index([predio_id, status])
  @@index([status, criado_em])
  @@map("manifestacoes")
}

model Material {
  id             String          @id @default(uuid())
  codigo         String          // Ex: MAT-ELE-001, SINAPI-1234
  nome           String          // Ex: Disjuntor Bipolar 32A Curva C
  categoria      String          @default("GERAL") // ELETRICA, HIDRAULICA, ALVENARIA, PINTURA, CLIMATIZACAO, GERAL
  unidade_medida String          @default("UN") // UN, METRO, LATA, SACO, PECA, KG
  preco_unitario Decimal         @default(0.00) @db.Decimal(10, 2)
  estoque_atual  Float           @default(0)
  estoque_minimo Float           @default(5)
  ativo          Boolean         @default(true)

  prefeitura_id  String?
  prefeitura     Prefeitura?     @relation(fields: [prefeitura_id], references: [id])

  itens_consumo  ItemConsumoOS[]

  criado_em      DateTime        @default(now())
  atualizado     DateTime        @updatedAt

  @@unique([prefeitura_id, codigo])
  @@index([prefeitura_id, categoria])
  @@map("materiais")
}

model ItemConsumoOS {
  id               String       @id @default(uuid())
  ordem_servico_id String
  ordem_servico    OrdemServico @relation(fields: [ordem_servico_id], references: [id], onDelete: Cascade)

  material_id      String?
  material         Material?    @relation(fields: [material_id], references: [id], onDelete: SetNull)

  descricao        String       // Descrição ou nome no ato da medição
  quantidade       Float        @default(1)
  unidade_medida   String       @default("UN")
  preco_unitario   Decimal      @default(0.00) @db.Decimal(10, 2)
  preco_total      Decimal      @default(0.00) @db.Decimal(10, 2)

  criado_em        DateTime     @default(now())

  @@index([ordem_servico_id])
  @@index([material_id])
  @@map("itens_consumo_os")
}

model ContratoManutencao {
  id                    String         @id @default(uuid())
  numero_contrato       String         // ex: "Contrato 014/2026"
  numero_empenho        String         // ex: "2026NE00412"
  empresa_contratada    String         // ex: "Alvorada Engenharia & Manutenção Urbana Ltda"
  cnpj_contratada       String?        // ex: "12.345.678/0001-90"
  objeto                String?        // ex: "Manutenção Predial Preventiva e Corretiva com Fornecimento de Peças"
  categoria_padrao      String?        @default("GERAL") // ELETRICA, HIDRAULICA, ALVENARIA, GERAL
  valor_total_empenhado Decimal        @default(0.00) @db.Decimal(12, 2)
  bdi_padrao            Decimal?       @default(20.00) @db.Decimal(5, 2) // BDI contratual padrão (%)
  vigencia_inicio       DateTime?
  vigencia_fim          DateTime?
  ativo                 Boolean        @default(true)

  prefeitura_id         String?
  prefeitura            Prefeitura?    @relation(fields: [prefeitura_id], references: [id])

  ordens_servico        OrdemServico[]
  boletins_medicao      BoletimMedicao[]

  criado_em             DateTime       @default(now())
  atualizado            DateTime       @updatedAt

  @@unique([prefeitura_id, numero_contrato])
  @@index([prefeitura_id, ativo])
  @@map("contratos_manutencao")
}

model BoletimMedicao {
  id                    String              @id @default(uuid())
  numero_boletim        String              // ex: "BM-2026-001"
  mes_competencia       Int                 // 1 a 12
  ano_competencia       Int                 // ex: 2026
  data_inicio           DateTime
  data_fim              DateTime
  status                String              @default("RASCUNHO") // RASCUNHO, APROVADO, PAGO, CANCELADO
  bdi_percentual        Decimal             @default(20.00) @db.Decimal(5, 2)
  valor_materiais       Decimal             @default(0.00) @db.Decimal(12, 2)
  valor_mao_de_obra     Decimal             @default(0.00) @db.Decimal(12, 2)
  valor_direto          Decimal             @default(0.00) @db.Decimal(12, 2)
  valor_bdi             Decimal             @default(0.00) @db.Decimal(12, 2)
  valor_total           Decimal             @default(0.00) @db.Decimal(12, 2)
  observacoes           String?
  hash_integridade      String?             // Assinatura digital SHA-256 do boletim consolidado

  fiscal_responsavel_id String?
  fiscal_responsavel    Usuario?            @relation("FiscalBoletim", fields: [fiscal_responsavel_id], references: [id], onDelete: SetNull)

  contrato_id           String
  contrato              ContratoManutencao  @relation(fields: [contrato_id], references: [id], onDelete: Cascade)

  prefeitura_id         String?
  prefeitura            Prefeitura?         @relation(fields: [prefeitura_id], references: [id])

  ordens_servico        OrdemServico[]

  criado_em             DateTime            @default(now())
  atualizado            DateTime            @updatedAt

  @@unique([prefeitura_id, numero_boletim])
  @@index([prefeitura_id, contrato_id, status])
  @@index([mes_competencia, ano_competencia])
  @@map("boletins_medicao")
}

model AtivoPredial {
  id                String         @id @default(uuid())
  codigo_patrimonio String         // ex: "PAT-2026-001", "EQP-CLI-104"
  nome              String         // ex: "Ar-Condicionado Split Inverter 24.000 BTUs"
  categoria         String         @default("CLIMATIZACAO") // CLIMATIZACAO, ELETRICA, HIDRAULICA, INCENDIO, ELEVADOR, MOBILIARIO, GERAL
  ambiente          String         // ex: "Sala de Aula 04", "Sala de Vacinação", "Casa de Máquinas"
  marca_modelo      String?        // ex: "Springer Midea AirVolution"
  numero_serie      String?        // ex: "SN-99482104"
  status            String         @default("OPERACIONAL") // OPERACIONAL, EM_MANUTENCAO, CRITICO, INATIVO
  data_instalacao   DateTime?
  garantia_ate      DateTime?
  ultima_manutencao DateTime?
  custo_acumulado   Decimal        @default(0.00) @db.Decimal(10, 2)
  ativo             Boolean        @default(true)

  predio_id         String
  predio            Predio         @relation(fields: [predio_id], references: [id], onDelete: Cascade)

  prefeitura_id     String?
  prefeitura        Prefeitura?    @relation(fields: [prefeitura_id], references: [id])

  ordens_servico    OrdemServico[]

  criado_em         DateTime       @default(now())
  atualizado        DateTime       @updatedAt

  @@unique([prefeitura_id, codigo_patrimonio])
  @@index([prefeitura_id, predio_id, ativo])
  @@index([predio_id, categoria])
  @@map("ativos_prediais")
}


