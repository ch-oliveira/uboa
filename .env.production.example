# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE: PRODUÇÃO (.env.production / Painel de Deploy)
# ==============================================================================
# ATENÇÃO: NUNCA commite valores reais de produção no repositório Git!
# Configure estas variáveis diretamente no painel do seu provedor de hospedagem
# (Render, Railway, Supabase, Neon, AWS, Vercel, etc.).
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Banco de Dados Gerenciado (PostgreSQL + PostGIS no Supabase / Nuvem) ---
# DATABASE_URL: Conexão via Pooler (porta 6543) para atender as requisições normais da API
DATABASE_URL="postgresql://postgres.[ref]:[sua_senha]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?sslmode=require"

# DIRECT_URL: Conexão direta/sessão (porta 5432) usada pelo Prisma para rodar migrações (pnpm db:migrate:deploy)
DIRECT_URL="postgresql://postgres.[ref]:[sua_senha]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Autenticação e Criptografia (NestJS - apps/api) ---
# OBRIGATÓRIO em produção: Gerar chave aleatória com mais de 32 caracteres.
# Dica para gerar no terminal: openssl rand -base64 36
JWT_SECRET="gere_uma_chave_aleatoria_longa_com_mais_de_32_caracteres_aqui"

# --- Bootstrap do Administrador Inicial (pnpm db:seed:prod) ---
# Usado apenas na primeira inicialização para criar o Admin de acesso ao sistema
ADMIN_INITIAL_EMAIL="admin@urboa.gov.br"
ADMIN_INITIAL_PASSWORD="DefinaUmaSenhaSuperForteParaOAdminAqui123!"

# --- URLs de Comunicação (CORS e Redirecionamentos) ---
# Porta em que a API NestJS vai escutar (geralmente injetada pelo provedor, ex: 8080 ou 3001)
PORT=3001
# URL pública do Frontend Web em Produção (utilizada no CORS da API)
FRONTEND_URL="https://predial.seudominio.com.br"

# --- Frontend Web (Next.js - apps/web) ---
# URL pública da API acessível pelo navegador do usuário final
NEXT_PUBLIC_API_URL="https://api.predial.seudominio.com.br/api"

# --- Inteligência Artificial (Google Gemini) ---
# Chave de produção da Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="sua_chave_gemini_de_producao_aqui"

# --- Vercel Feature Flags & Toolbar (Next.js - apps/web) ---
# Configurar nas Environment Variables do projeto na Vercel (Produção e Preview)
FLAGS_SECRET="gerar_32_bytes_base64url_para_producao_aqui"

