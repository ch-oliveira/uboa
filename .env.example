# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE: DESENVOLVIMENTO LOCAL (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do monorepo para rodar localmente.
# Para o modelo de produção, consulte: .env.production.example
# ==============================================================================

NODE_ENV=development

# --- Banco de Dados Local (Docker PostGIS na porta 5432) ---
# Usado por: packages/database e apps/api
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/predial_db?schema=public"
DIRECT_URL="postgresql://root:rootpassword@localhost:5432/predial_db?schema=public"

# --- Autenticação e Segurança (apps/api e packages/database) ---
# Em desenvolvimento, pode usar chave de teste. Em produção deve ter >= 32 caracteres.
JWT_SECRET="dev_secret_predial_zeladoria_urbana_local_test_key_2026"
# Senha padrão para povoamento inicial de usuários fictícios via seed local (pnpm db:seed)
SEED_DEFAULT_PASSWORD="Urboa@2026!"

# --- Backend API (NestJS - apps/api) ---
PORT=3001
FRONTEND_URL="http://localhost:3000"

# --- Frontend Web (Next.js - apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- Inteligência Artificial (Google Gemini - apps/api) ---
# Obtenha em: https://aistudio.google.com/
# Se deixado em branco, o sistema executa o motor inteligente local com ferramentas reais do banco.
GEMINI_API_KEY="sua_chave_gemini_aqui"

# --- Vercel Feature Flags & Toolbar (Next.js - apps/web) ---
# Chave criptográfica de 32 bytes para assinar e sincronizar flags com Vercel Flags Explorer
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FLAGS_SECRET="q4Jk6B1JQNNM6SwBG6MjrHR9NU6By4nMqjH3WgNZRU4"

