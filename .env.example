# ========================================================
# Configuração de Ambiente - Exemplo (predial-monorepo)
# Copie este arquivo para .env ou conforme a necessidade de cada app/package.
# ========================================================

# --- Banco de Dados (PostgreSQL / Prisma) ---
# Usado por: packages/database e apps/api
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/predial_db?schema=public"

# --- Autenticação e Segurança (apps/api e packages/database) ---
# Chave secreta HMAC-SHA256 para assinatura de tokens JWT (obrigatório >= 32 caracteres em produção)
JWT_SECRET="gere_uma_chave_aleatoria_longa_com_mais_de_32_caracteres_aqui"
# Senha padrão para povoamento inicial de usuários via seed (apenas dev/staging)
SEED_DEFAULT_PASSWORD="defina_uma_senha_forte_para_o_seed_aqui"

# --- Backend API (NestJS - apps/api) ---
PORT=3001
FRONTEND_URL="http://localhost:3000"

# --- Frontend Web (Next.js - apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- Inteligência Artificial (Google Gemini - apps/api) ---
# Obtenha em: https://aistudio.google.com/
# Se deixado em branco, o sistema executa o motor inteligente local com ferramentas reais do banco.
GEMINI_API_KEY="sua_chave_gemini_aqui"
