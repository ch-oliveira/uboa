# ========================================================
# Configuração de Ambiente - Exemplo (predial-monorepo)
# Copie este arquivo para .env ou conforme a necessidade de cada app/package.
# ========================================================

# --- Banco de Dados (PostgreSQL / Prisma) ---
# Usado por: packages/database e apps/api
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/predial_db?schema=public"

# --- Backend API (NestJS - apps/api) ---
PORT=3001
FRONTEND_URL="http://localhost:3000"

# --- Frontend Web (Next.js - apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
